# TifoXR database access file. LOCAL ONLY. NEVER COMMIT. NEVER SHARE.
# Fill in the values yourself. Use read-only credentials where you can. One value per line, no quotes.
# Claude never opens or prints this file; the refresh script reads it by itself.

# ---- Azure SQL: DEV database (used by the database refresh) ----
# Signs in with Microsoft Entra, like: sqlcmd -G -U <email> -P <password>
SQL_DEV_SERVER=
SQL_DEV_DATABASE=
# Your Entra email and password. Leave USER empty only for Windows authentication.
SQL_DEV_USER=
SQL_DEV_PASSWORD=
# Optional: set to 1 only for servers with a self-signed certificate (not needed for Azure SQL)
SQL_DEV_TRUST_CERT=
# Optional: full path to sqlcmd if it is not on the PATH
SQLCMD_PATH=

# ---- Azure (service principal with Reader role only), optional ----
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID_DEV=
AZURE_SUBSCRIPTION_ID_PROD=

# ---- Azure Blob (read-only token or connection string), optional ----
BLOB_DEV_READONLY=
BLOB_PROD_READONLY=

# ---- Azure DevOps (PAT with read-only scopes), optional ----
AZDO_ORG_URL=https://dev.azure.com/globalmobisoft
AZDO_PAT=
