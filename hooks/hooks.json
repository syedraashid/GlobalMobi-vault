{
  "_comment": "Plugin hooks. SessionStart matchers are literal strings, not regex, so each event gets its own entry (same finding as the LTK plugin). Commands use the exec form (command plus args) so no shell is involved and ${CLAUDE_PLUGIN_ROOT} works on Windows.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject-index.js"] }]
      },
      {
        "matcher": "resume",
        "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject-index.js"] }]
      },
      {
        "matcher": "clear",
        "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject-index.js"] }]
      },
      {
        "matcher": "compact",
        "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject-index.js"] }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard.js"] }]
      },
      {
        "matcher": "PowerShell",
        "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard.js"] }]
      }
    ]
  }
}
